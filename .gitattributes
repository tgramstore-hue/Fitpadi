# Normalize line endings for all text files to LF in the repo
* text=auto eol=lf

# Force LF for JS/TS/CSS/HTML source files
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# Binaries — no line-ending conversion
*.mp4   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.gif   binary
*.svg   text eol=lf

